# copier en .env, aucune valeur secrète ne doit être commitée
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/todo_dev
# 32 caractères minimum, générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacer-par-un-secret-aleatoire-de-64-caracteres-hexadecimaux
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
# en prod : COOKIE_SECURE=true, et COOKIE_SAMESITE=none si le front et l'api ne sont pas sur le même domaine
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_AUTH_MAX=20
