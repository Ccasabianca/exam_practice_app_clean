{
  "name": "backend",
  "version": "1.1.0",
  "description": "API REST de l'application Mes Tâches (Express 5, MongoDB, JWT en cookie HTTPOnly)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "jsdoc -c jsdoc.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
